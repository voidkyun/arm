cabal-version: 3.8
name: arm-example-task
version: 0.1.0.0
synopsis: Task management example for Algebra Relational Mapping
description:
  Sample application package boundary for ARM. This package depends on the
  reusable ARM libraries and must not be required by them.
category: Web
build-type: Simple
license: NONE

library domain
  exposed-modules: Task.Domain
  hs-source-dirs: domain
  build-depends: base >=4.18 && <5, containers >=0.6 && <0.8
  default-language: GHC2021
  ghc-options: -Wall

library
  exposed-modules: Task.HTTP, Task.SQL
  hs-source-dirs: src
  build-depends:
      arm-core, arm-wai, arm-example-task:domain,
      aeson >=2.0 && <2.3, base >=4.18 && <5,
      bytestring >=0.12 && <0.13, containers >=0.6 && <0.8,
      http-types >=0.12 && <0.13, text >=2.0 && <2.2, wai >=3.2 && <3.3
  default-language: GHC2021
  ghc-options: -Wall

executable arm-example-task
  main-is: Main.hs
  hs-source-dirs:
      app
  build-depends:
      arm-core,
      arm-example-task,
      arm-postgresql,
      arm-wai,
      base >=4.18 && <5,
      bytestring >=0.12 && <0.13,
      postgresql-simple >=0.7 && <0.8,
      resource-pool >=0.4 && <0.5,
      wai >=3.2 && <3.3,
      warp >=3.3 && <3.5
  default-language: GHC2021
  ghc-options: -Wall -threaded

test-suite task-domain-test
  type: exitcode-stdio-1.0
  main-is: Domain.hs
  hs-source-dirs: test
  build-depends:
      arm-example-task:domain, base >=4.18 && <5, containers >=0.6 && <0.8,
      tasty >=1.5 && <1.6, tasty-hunit >=0.10 && <0.11, tasty-quickcheck >=0.11 && <0.12
  default-language: GHC2021
  ghc-options: -Wall

executable task-sql-check
  main-is: Integration.hs
  hs-source-dirs: test
  build-depends:
      arm-core, arm-postgresql, arm-example-task, arm-example-task:domain,
      base >=4.18 && <5, bytestring >=0.12 && <0.13,
      postgresql-simple >=0.7 && <0.8, resource-pool >=0.4 && <0.5
  default-language: GHC2021
  ghc-options: -Wall -threaded
